<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <AssemblyName>sws2-cs2mapmanager</AssemblyName>
    <RootNamespace>Sws2Cs2MapManager</RootNamespace>
    <OutputPath>$(MSBuildThisFileDirectory)build/</OutputPath>
    <PublishDir>$(OutputPath)publish/sws2-cs2mapmanager</PublishDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.0" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.0" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.0" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.0" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="SwiftlyS2.CS2" Version="*" ExcludeAssets="runtime" PrivateAssets="all" />
    <!-- Avoid the vulnerable transitive version bundled by current SwiftlyS2 releases. -->
    <PackageReference Include="MySqlConnector" Version="2.6.1" ExcludeAssets="runtime" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="contracts/Sws2Cs2MapManager.Contracts.csproj" Private="false" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="contracts\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="resources/templates/**/*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <Target Name="PrepareContracts">
    <MSBuild Projects="contracts/Sws2Cs2MapManager.Contracts.csproj"
             Targets="GetTargetPath"
             Properties="Configuration=$(Configuration)">
      <Output TaskParameter="TargetOutputs" ItemName="MapManagerContractsTargetPath" />
    </MSBuild>
    <MakeDir Directories="$(OutDir)resources/exports" />
    <Copy SourceFiles="@(MapManagerContractsTargetPath)" DestinationFolder="$(OutDir)" />
    <Copy SourceFiles="@(MapManagerContractsTargetPath)" DestinationFolder="$(OutDir)resources/exports" />
  </Target>

  <Target Name="CopyContracts" AfterTargets="Build" DependsOnTargets="PrepareContracts" />

  <Target Name="CreateZip" AfterTargets="Publish" DependsOnTargets="PrepareContracts">
    <MakeDir Directories="$(PublishDir)resources/exports" />
    <Copy SourceFiles="@(MapManagerContractsTargetPath)" DestinationFolder="$(PublishDir)" />
    <Copy SourceFiles="@(MapManagerContractsTargetPath)" DestinationFolder="$(PublishDir)resources/exports" />

    <ZipDirectory SourceDirectory="$(PublishDir)../" DestinationFile="$(OutputPath)../$(AssemblyName).zip" Overwrite="true" />
  </Target>

</Project>
